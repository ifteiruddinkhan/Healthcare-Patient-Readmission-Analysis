# ==========================================
# Data Files
# ==========================================
# Explicitly track your raw healthcare dataset
!Raw_Healthcare.csv
!data/Raw_Healthcare.csv

# Ignore other Excel exports/logs
*.xlsx
*.xls
*.log

# ==========================================
# Temporary Office/Power BI Lock Files
# ==========================================
# Ignores hidden temp files created when applications are open
~$*
*.tmp

# ==========================================
# Database Files
# ==========================================
*.db
*.sqlite
*.sqlite3

# ==========================================
# Python & System Artifacts
# ==========================================
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store
Thumbs.db
.vscode/
.idea
